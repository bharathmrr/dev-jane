# ---- App ----
ENV=dev
DEBUG=true
DEFAULT_TIMEZONE=UTC

# ---- Security (generate strong random values for prod) ----
# python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me-to-a-long-random-string-min-32-chars
EMAIL_HMAC_SECRET=change-me-min-16-chars
ACCESS_TOKEN_TTL_MINUTES=30
REFRESH_TOKEN_TTL_DAYS=14

# ---- Database ----
DATABASE_URL=postgresql://neondb_owner:npg_aOZsk6jJiS5X@ep-billowing-sunset-a810a1z5-pooler.eastus2.azure.neon.tech/neondb?sslmode=require&channel_binding=require

# ---- Redis / reservations ----
REDIS_URL=redis://redis:6379/0
RESERVATION_TTL_SECONDS=600
LOCK_TIMEOUT_SECONDS=5

# ---- LLM (intent parsing) ----
LLM_PROVIDER=anthropic         # anthropic | stub
ANTHROPIC_API_KEY=
LLM_INTENT_MODEL=claude-haiku-4-5
LLM_NEGOTIATION_MODEL=claude-sonnet-4-6

# ---- SMTP (outbound) ----
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=false
SMTP_FROM_EMAIL=scheduler@example.com
SMTP_FROM_NAME=Scheduling Assistant
INBOUND_DOMAIN=reply.example.com

# ---- IMAP (inbound polling; or use the webhook endpoint instead) ----
IMAP_HOST=mailpit
IMAP_PORT=1143
IMAP_USERNAME=
IMAP_PASSWORD=
IMAP_USE_SSL=false
IMAP_POLL_INTERVAL_SECONDS=60

# ---- Reminders ----
REMINDER_LEAD_MINUTES=60

# ---- Observability ----
LOG_LEVEL=INFO
LOG_JSON=true
PROMETHEUS_ENABLED=true

# ---- Rate limiting ----
RATE_LIMIT_PER_MINUTE=120

# ---- Monitoring stack ----
GRAFANA_PASSWORD=admin
