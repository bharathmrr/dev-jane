# ---- App ----
ENV=dev
DEBUG=true
DEFAULT_TIMEZONE=UTC

# ---- Security (generate strong random values for prod) ----
# python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me-to-a-long-random-string-min-32-chars
EMAIL_HMAC_SECRET=change-me-min-16-chars
ACCESS_TOKEN_TTL_MINUTES=30
REFRESH_TOKEN_TTL_DAYS=14

# ---- Database ----
DATABASE_URL=postgresql://neondb_owner:npg_aOZsk6jJiS5X@ep-billowing-sunset-a810a1z5-pooler.eastus2.azure.neon.tech/neondb?sslmode=require&channel_binding=require

# ---- Redis / reservations ----
REDIS_URL=redis://redis:6379/0
RESERVATION_TTL_SECONDS=600
LOCK_TIMEOUT_SECONDS=5

# ---- LLM (intent parsing) ----
LLM_PROVIDER=anthropic         # anthropic | stub
ANTHROPIC_API_KEY=
LLM_INTENT_MODEL=claude-haiku-4-5
LLM_NEGOTIATION_MODEL=claude-sonnet-4-6

# ---- SMTP (outbound — Gmail recommended) ----
# For Gmail: enable 2-Step Verification, then generate an App Password at
# https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USERNAME=you@gmail.com
SMTP_PASSWORD=your-gmail-app-password
SMTP_FROM_EMAIL=you@gmail.com
SMTP_FROM_NAME=Your Name
INBOUND_DOMAIN=reply.example.com

# ---- IMAP (inbound polling; or use the webhook endpoint instead) ----
IMAP_HOST=mailpit
IMAP_PORT=1143
IMAP_USERNAME=
IMAP_PASSWORD=
IMAP_USE_SSL=false
IMAP_POLL_INTERVAL_SECONDS=60

# ---- Reminders ----
REMINDER_LEAD_MINUTES=60

# ---- Observability ----
LOG_LEVEL=INFO
LOG_JSON=true
PROMETHEUS_ENABLED=true

# ---- Rate limiting ----
RATE_LIMIT_PER_MINUTE=120

# ---- Monitoring stack ----
GRAFANA_PASSWORD=admin
